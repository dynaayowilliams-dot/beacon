{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "corepack pnpm --workspace-root install --frozen-lockfile",
  "buildCommand": "corepack pnpm --workspace-root run build:vercel",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    { "source": "/app", "destination": "/index.html" },
    { "source": "/demo", "destination": "/index.html" },
    { "source": "/notice/:path*", "destination": "/index.html" }
  ]
}
